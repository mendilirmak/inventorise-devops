# Managed by Ansible.
listen_addresses = 'localhost,{{ ansible_facts['default_ipv4']['address'] }}'
password_encryption = scram-sha-256
ssl = on                      # encrypts connections, using the Ubuntu default certificate
wal_level = replica
max_wal_senders = 5
wal_keep_size = 256MB         # keeps enough log for the standby to catch up after a short outage
hot_standby = on
